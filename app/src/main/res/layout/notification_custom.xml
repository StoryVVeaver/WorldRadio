<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/background"
    android:padding="8dp">

    <ImageView
        android:id="@+id/image_view_station_notification"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true" />

    <TextView
        android:id="@+id/station_name_notification"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/image_view_station_notification"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:textColor="@color/white"
        android:layout_toStartOf="@+id/play_pause_notification"
        android:layout_toEndOf="@id/image_view_station_notification"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/track_notification"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:layout_below="@id/station_name_notification"
        android:layout_marginStart="10dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="10dp"
        android:layout_toStartOf="@+id/play_pause_notification"
        android:layout_toEndOf="@id/image_view_station_notification"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/play_pause_notification"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginEnd="50dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:padding="10dp"
        android:src="@drawable/pause" />

    <ImageView
        android:id="@+id/stop_notification"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:padding="10dp"
        android:src="@drawable/delete" />
</RelativeLayout>
